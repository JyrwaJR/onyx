{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    "paths": {
      "@/*": ["./*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/shared/components/*"],
      "@sharedType/*": ["./src/shared/types/*"],
      "@assets/*": ["./src/shared/assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",

    "expo-env.d.ts",
    "css-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
