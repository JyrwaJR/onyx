# ============================================================
# MCP — manage MCP (Model Context Protocol) servers.
# Docs: https://opencode.ai/v2/docs/api
# ============================================================


### List MCP servers
GET {{BASE_URL}}/api/mcp

### Add MCP server
PUT {{BASE_URL}}/api/mcp/{{server}}
Content-Type: application/json

{
  "command": "npx",
  "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
  "type": "stdio"
}

### Remove MCP server
DELETE {{BASE_URL}}/api/mcp/{{server}}

### Connect MCP server
POST {{BASE_URL}}/api/mcp/{{server}}/connect
Content-Type: application/json

{}

### Disconnect MCP server
POST {{BASE_URL}}/api/mcp/{{server}}/disconnect
Content-Type: application/json

{}

### List MCP resources
GET {{BASE_URL}}/api/mcp/resource
