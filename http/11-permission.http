# ============================================================
# Permission — request / grant / deny tool permissions.
# Docs: https://opencode.ai/v2/docs/api
# ============================================================


### List permission requests (global)
GET {{BASE_URL}}/api/permission/request

### List saved permissions
GET {{BASE_URL}}/api/permission/saved

### Remove saved permission
DELETE {{BASE_URL}}/api/permission/saved/{{id}}

### Create permission request (in a session)
POST {{BASE_URL}}/api/session/{{sessionID}}/permission
Content-Type: application/json

{
  "tool": "bash",
  "input": {
    "command": "rm -rf build/"
  }
}

### List session permission requests
GET {{BASE_URL}}/api/session/{{sessionID}}/permission

### Get permission request
GET {{BASE_URL}}/api/session/{{sessionID}}/permission/{{requestID}}

### Reply to permission request
POST {{BASE_URL}}/api/session/{{sessionID}}/permission/{{requestID}}/reply
Content-Type: application/json

{
  "decision": "grant"
}
