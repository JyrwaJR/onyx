# ============================================================
# Session — the primary interaction API.
# Docs: https://opencode.ai/v2/docs/api
#
# SESSION_ID pattern: /^[a-zA-Z0-9-]{6,70}$/
# Use a real session id (e.g. from List sessions) in place of {{SESSION_ID}}.
# ============================================================


# ------------------------------------------------------------------
# Session CRUD
# ------------------------------------------------------------------

### List sessions
GET {{BASE_URL}}/api/session

### Create session
POST {{BASE_URL}}/api/session
Content-Type: application/json

{
  "data": {
    "title": "My new session"
  }
}

### Get session statistics
GET {{BASE_URL}}/api/session/stats

### Import session
POST {{BASE_URL}}/api/session/import
Content-Type: application/json

{
  "info": {
    "id": "session-id",
    "title": "Imported session"
  },
  "data": {}
}

### Export session
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/export

### List active sessions
GET {{BASE_URL}}/api/session/active

### Get session
GET {{BASE_URL}}/api/session/{{SESSION_ID}}

### Delete session
DELETE {{BASE_URL}}/api/session/{{SESSION_ID}}

### Fork session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/fork
Content-Type: application/json

{
  "boundary": "step"
}

### Switch session agent
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/agent
Content-Type: application/json

{
  "agent": "build"
}

### Switch session model
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/model
Content-Type: application/json

{
  "model": "gpt-4o"
}

### Rename session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/rename
Content-Type: application/json

{
  "title": "New session title"
}

### Move session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/move
Content-Type: application/json

{
  "directory": "/some/workspace/path",
  "workspaceId": "optional-workspace-id"
}

# ------------------------------------------------------------------
# Interact with a session
# ------------------------------------------------------------------

### Send message (prompt the agent)
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/prompt
Content-Type: application/json

{
  "id": "optional-user-message-id",
  "data": {
    "type": "user",
    "text": "Explain the codebase in a few sentences."
  }
}

### Run a command in the session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/command
Content-Type: application/json

{
  "command": "/fix",
  "text": "",
  "files": []
}

### Activate a skill in the session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/skill
Content-Type: application/json

{
  "id": "skill-name"
}

### Add a synthetic message
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/synthetic
Content-Type: application/json

{
  "id": "optional-synthetic-id",
  "data": {
    "type": "assistant"
  }
}

### Run a shell command in the session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/shell
Content-Type: application/json

{
  "id": "optional-shell-command-id"
}

# ------------------------------------------------------------------
# Session lifecycle
# ------------------------------------------------------------------

### Compact session
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/compact
Content-Type: application/json

{
  "id": "optional-compact-id",
  "data": {}
}

### Wait for session (block until idle)
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/wait
Content-Type: application/json

{}

### Interrupt session execution
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/interrupt
Content-Type: application/json

{}

### Background blocking session tools
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/background
Content-Type: application/json

{}

# ------------------------------------------------------------------
# Revert (undo staged changes)
# ------------------------------------------------------------------

### Stage session revert
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/revert/stage
Content-Type: application/json

{
  "message": "Without this change"
}

### Clear staged revert
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/revert/clear
Content-Type: application/json

{}

### Commit staged revert
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/revert/commit
Content-Type: application/json

{}

# ------------------------------------------------------------------
# Context, inbox, instructions
# ------------------------------------------------------------------

### Get session context
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/context

### List session inbox (queued / pending tasks)
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/inbox

### Cancel inbox input
DELETE {{BASE_URL}}/api/session/{{SESSION_ID}}/inbox/{{inboxID}}

### Steer queued item (change its direction)
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/inbox/{{inboxID}}/steer
Content-Type: application/json

{
  "data": {
    "type": "user",
    "text": "Actually, do this instead."
  }
}

### Queue a steered item
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/inbox/{{inboxID}}/queue
Content-Type: application/json

{
  "data": {
    "type": "user",
    "text": "Queued task"
  }
}

### List instruction entries
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/instructions/entries

### Put instruction entry
PUT {{BASE_URL}}/api/session/{{SESSION_ID}}/instructions/entries/{{key}}
Content-Type: application/json

{
  "value": "Run tests after every change."
}

### Remove instruction entry
DELETE {{BASE_URL}}/api/session/{{SESSION_ID}}/instructions/entries/{{key}}

# ------------------------------------------------------------------
# Generate / messages
# ------------------------------------------------------------------

### Generate text from session context
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/generate
Content-Type: application/json

{
  "text": "Summarize the current state of this session",
  "context": {}
}

### Read the session log (SSE)
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/log
Accept: text/event-stream

### Get session messages
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/message

### Get a specific message
GET {{BASE_URL}}/api/session/{{SESSION_ID}}/message/{{messageID}}

### Update assistant message content
PATCH {{BASE_URL}}/api/session/{{SESSION_ID}}/message/{{messageID}}
Content-Type: application/json

{
  "content": [
    {
      "type": "text",
      "text": "Updated assistant reply"
    }
  ]
}

### Set session environment
PUT {{BASE_URL}}/api/session/{{SESSION_ID}}/environment
Content-Type: application/json

{
  "env": {
    "EDITOR": "code"
  }
}

### View session (render snapshot)
POST {{BASE_URL}}/api/session/{{SESSION_ID}}/view
Content-Type: application/json

{
  "mode": "full"
}
