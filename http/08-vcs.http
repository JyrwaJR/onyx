# ============================================================
# VCS — version control / git.
# Docs: http://localhost:4096/doc
# ============================================================

### Get VCS info
GET {{BASE_URL}}/vcs

### Get VCS status
GET {{BASE_URL}}/vcs/status

### Get VCS diff
GET {{BASE_URL}}/vcs/diff
# Query params: mode (required: git|branch), context, directory, workspace
# Example: GET http://localhost:4096/vcs/diff?mode=git

### Get raw VCS diff
GET {{BASE_URL}}/vcs/diff/raw

### Apply a VCS patch
POST {{BASE_URL}}/vcs/apply
Content-Type: application/json

{
  "patch": "diff --git a/src/index.ts b/src/index.ts\nindex 0000000..1111111 100644\n--- a/src/index.ts\n+++ b/src/index.ts\n@@ -1,3 +1,4 @@\n+console.log('hello')\n"
}